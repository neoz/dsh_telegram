# Only the llm-proxy service receives this; the agent container gets a placeholder.
DEEPSEEK_API_KEY=
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids or usernames allowed to talk to the agent.
TELEGRAM_ALLOW_FROM=
# Comma-separated Telegram user ids (not usernames) allowed to edit the global memory.
TELEGRAM_SUPER_ADMINS=
# Let the bot react to or reply in active groups that have not addressed it for a while.
TELEGRAM_IDLE_ENABLED=false
# Comma-separated group chat ids (supergroups are negative, e.g. -1001234567890).
# A group's id appears in the bot log lines "chat <id> message ...".
TELEGRAM_IDLE_CHATS=
DSH_MODEL=deepseek-v4-flash
# Any random string; SearXNG signs its own cookies/forms with it.
SEARXNG_SECRET=
