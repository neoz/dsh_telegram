# Pass-through to DeepSeek's Messages-compatible API that swaps the agent's placeholder
# key for the real one. Requests are forwarded unchanged, so Files API image references
# and beta headers reach DeepSeek as dsh sent them.
server {
    listen 8080;
    # dsh uploads images through the Files API (up to 128 MiB) and may inline them.
    client_max_body_size 128m;

    location /anthropic/ {
        proxy_pass https://api.deepseek.com;
        proxy_ssl_server_name on;
        proxy_set_header Host api.deepseek.com;
        proxy_set_header x-api-key ${DEEPSEEK_API_KEY};
        proxy_http_version 1.1;
        # Stream responses as they arrive and allow long generations.
        proxy_buffering off;
        proxy_read_timeout 600s;
    }

    location / {
        return 404;
    }
}
